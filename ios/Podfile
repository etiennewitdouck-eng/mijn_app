# Uncomment this line to define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = '1'

project 'Runner', {
  'Debug' => :debug,
  'Release' => :release,
  'Profile' => :profile,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install, make sure flutter pub get has been executed first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    @target = $1 if line =~ /^FLUTTER_ROOT\s*=\s*(.*)$/
  end
  raise "FLUTTER_ROOT not found in this file. See Flutter installation instruction / g.v. cookbook." if @target.nil?
  @target.chomp
end

root = flutter_root
load File.join(root, 'packages', 'flutter_tools', 'bin', 'podhelper.rb')

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.expand_path('..', __dir__)
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end

